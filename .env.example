# Variables de docker-compose.yml. Copia este fichero como .env (en la raiz,
# junto a docker-compose.yml) y cambia TODAS las contraseñas.
# La configuracion de la app en si (marca, modulos, login) va aparte, en
# app_fastapi/.env -- ver app_fastapi/.env.example.

# bd-docker = MariaDB en un contenedor propio. Vacio = usar un servidor externo
# (rellena entonces DB_HOST y DB_PORT).
COMPOSE_PROFILES=bd-docker
DB_HOST=db
DB_PORT=3306

# Usuario de la app: el instalador lo crea con permisos solo sobre sus BD.
DB_USER=app_tareas
DB_PASSWORD=cambia-esta-contraseña
DB_NAME=app_tareas
# BD de pruebas (vacio = sin entorno de pruebas)
DB_NAME_TEST=app_tareas_test

# Root (o un usuario que pueda crear BD y usuarios) -- solo lo usa el
# instalador la primera vez.
DB_ROOT_USER=root
DB_ROOT_PASSWORD=cambia-esta-otra

# Primer arranque: administrador y datos de ejemplo (1 = con demo, 0 = vacia)
INSTALAR_ADMIN=admin
INSTALAR_ADMIN_PASSWORD=cambia-tambien-esta
INSTALAR_DEMO=1

# Cadena larga al azar: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=

APP_PUERTO=8000
